PROVIDER=mock

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OPTIMIZE_SCORE_THRESHOLD=0.8
OPTIMIZE_MAX_REPAIR_RETRIES=1
OPTIMIZE_TIMEOUT_MS=8000
OPTIMIZE_FAIL_OPEN=true

AUDIT_PATH=data/audit.jsonl

# ---------------------------------------------------------------------------
# harness 驱动是任务的主路径，默认开启：先由 harness 生成回答，再进同一条优化管线。
# 开启不等于可执行——没有任何可驱动成员时（无 CLI、无密钥），build_harness 返回 None，
# POST /v1/run 回 503 并指回 /v1/optimize；已有输出者无需配置 harness 也能用主接口。
# 三条来源的 argv 都不来自请求体：请求体只能提供 task 与 profile 名。
# 命令类配置只写在这里（.env 已 gitignore），config/pipeline.yaml 不接受它们。
# HARNESS_ARGS 与 HARNESS_ALLOWED_COMMANDS 用 JSON 数组：路径里可能有空格与反斜杠。
# ---------------------------------------------------------------------------
HARNESS_ENABLED=true
# 逗号分隔的 profile 白名单（如 codex,openai-api）；留空表示全部可用。
# 只想走 OpenAI 兼容 API（如 DeepSeek）时写 openai-api，并把 HARNESS_DETECT=false。
HARNESS_PROVIDERS=
# 默认使用的 profile；留空取第一个可用的。
HARNESS_PROFILE=
# 是否扫描本机已安装的内置 profile CLI。
HARNESS_DETECT=true
# 页面点「带探测重新检测」时执行 --version / login status 的超时。
HARNESS_PROBE_TIMEOUT_MS=5000

# 方式一（可选）：显式指定一条命令。留空即完全依赖发现或 API。
# 可执行文件必须是绝对路径、真实存在，且出现在 HARNESS_ALLOWED_COMMANDS 中。
HARNESS_COMMAND=
HARNESS_ALLOWED_COMMANDS=[]
HARNESS_ARGS=[]
# 子进程工作目录；发现式 profile 未设置时会自动落到一个独立的临时空目录，
# 避免外部 agent 继承服务进程的 cwd（也就是本仓库）。
HARNESS_CWD=
HARNESS_TIMEOUT_MS=120000
HARNESS_MAX_OUTPUT_BYTES=262144
HARNESS_MAX_CONCURRENCY=1
# 逗号分隔的额外环境变量名。加入的变量会真的进入子进程，
# 密钥类变量（如 OPENAI_API_KEY）不要写在这里。
HARNESS_ENV_ALLOW=

# 方式二：OpenAI 兼容 API 直连。只要 OPENAI_API_KEY 非空即自动注册 openai-api profile，
# 复用上面的 OPENAI_BASE_URL / OPENAI_MODEL；密钥不进请求体也不进审计。

# 方式三：自动发现内置 profile。当前登记表为 codex 与 opencode：
#   codex    —— npm 装的是 codex.cmd/.ps1 包装，shell=False 下不能直接执行，
#               发现器解析为 node.exe + bin/codex.js；沙箱固定 -s read-only。
#   opencode —— 已能发现（真实 exe 常在平台子包内，而非 package.json 声明的 bin），
#               但非交互调用方式未验证，因此只检测、不驱动。
# 注意 codex 真跑要求已安装 CLI 版本支持账号当前模型，否则非零退出。

PROVIDER=mock

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OPTIMIZE_SCORE_THRESHOLD=0.8
OPTIMIZE_MAX_REPAIR_RETRIES=1
OPTIMIZE_TIMEOUT_MS=8000
OPTIMIZE_FAIL_OPEN=true

AUDIT_PATH=data/audit.jsonl

# harness 驱动属实验面，默认关闭；POST /v1/run 在未启用时恒返回 503。
# 命令与参数只能写在这里（.env 已被 gitignore），不要写进 config/pipeline.yaml。
# HARNESS_ARGS 与 HARNESS_ALLOWED_COMMANDS 是 JSON 数组：路径里可能有空格与反斜杠。
# 请求体只能提供 task 文本，无法指定命令、参数、工作目录或环境变量。
HARNESS_ENABLED=false
HARNESS_COMMAND=
HARNESS_ALLOWED_COMMANDS=[]
HARNESS_ARGS=[]
HARNESS_CWD=
HARNESS_TIMEOUT_MS=120000
HARNESS_MAX_OUTPUT_BYTES=262144
HARNESS_MAX_CONCURRENCY=1
# 逗号分隔的额外环境变量名。注意：加入的变量会真的进入子进程，
# 密钥类变量（如 OPENAI_API_KEY）不要写在这里。
HARNESS_ENV_ALLOW=

# 驱动 npm 版 Codex CLI 的参考配置（Windows 下不能直接 exec codex.cmd/.ps1，
# 必须指向 node 可执行文件并把 codex.js 作为固定参数；沙箱一律锁 read-only）：
# HARNESS_ENABLED=true
# HARNESS_COMMAND="D:\\Node.js\\node.exe"
# HARNESS_ALLOWED_COMMANDS=["D:\\Node.js\\node.exe"]
# HARNESS_ARGS=["C:\\Users\\<you>\\AppData\\Roaming\\npm\\node_modules\\@openai\\codex\\bin\\codex.js","exec","-s","read-only","--ephemeral","-o","{output_file}","-"]
# HARNESS_CWD=<一个空的临时目录，避免 harness 在当前仓库里工作>

# 环境与依赖
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 本地密钥
.env
# 改配置前的手改备份同样可能带密钥，别让它有被提交的机会
.env.*

# 运行产物
# CI 的 4 个作业往这里写 junit/coverage/evaluation 产物；照 CI 命令本地复跑就会造出来
artifacts/
data/audit.jsonl
# 评估报告含逐条耗时，每次运行字节级不同，作为本地产物；关键结果已写入 README §9
data/reports/*
!data/reports/.gitkeep
